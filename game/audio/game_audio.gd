class_name GameAudio
extends RefCounted
## One-shot and looping sounds. Placeholder sounds live in res://assets/audio and
## are generated by tools/make_placeholder_audio.py; replace the .wav files to swap them.

static var sfx_volume := 1.0
static var music_volume := 0.7
static var _cache := {}


static func stream(sound: String) -> AudioStream:
	if _cache.has(sound):
		return _cache[sound]
	var path := "res://assets/audio/%s.wav" % sound
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path)
	_cache[sound] = s
	return s


## A looping copy of a sound (engine hum, music).
static func looped(sound: String) -> AudioStream:
	var s := stream(sound)
	if s is AudioStreamWAV:
		var w: AudioStreamWAV = (s as AudioStreamWAV).duplicate()
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
		return w
	return s


static func play_at(sound: String, pos: Vector3, volume: float = 1.0, pitch: float = 1.0) -> void:
	var s := stream(sound)
	var tree := Engine.get_main_loop() as SceneTree
	if s == null or tree == null or tree.root == null:
		return
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.volume_db = linear_to_db(maxf(volume * sfx_volume, 0.0001))
	p.pitch_scale = pitch * randf_range(0.94, 1.06)
	p.unit_size = 14.0
	p.max_distance = 140.0
	p.position = pos
	p.finished.connect(p.queue_free)
	tree.root.add_child(p)
	p.play()


static func play_ui(sound: String, volume: float = 1.0) -> void:
	var s := stream(sound)
	var tree := Engine.get_main_loop() as SceneTree
	if s == null or tree == null or tree.root == null:
		return
	var p := AudioStreamPlayer.new()
	p.stream = s
	p.volume_db = linear_to_db(maxf(volume * sfx_volume, 0.0001))
	p.process_mode = Node.PROCESS_MODE_ALWAYS
	p.finished.connect(p.queue_free)
	tree.root.add_child(p)
	p.play()
